# 2161 samples
import mpc_math

program.use_trunc_pr = True
program.use_edabit(True)

sfix.set_precision(20, 20 + 27)

# Program variables
n = 2161
n_frames_per_sub_interval = 6  # maps 10 minute windows
n_iterations = 10
base_times = [0, 2, 4, 6, 8, 10]


def lagrange_interpolation(t_values, y_values, t_target):
    result = 0.0

    for i in range(6):
        L_i = 1.0
        for j in range(6):
            if j != i:
                L_i *= (t_target - t_values[j]) / (t_values[i] - t_values[j])

        result += y_values[i] * L_i

    return result


def interpolate_state_vectors(times, positions, target_time):
    interpolated_position = []

    for coord in range(3):
        y_values = [pos[coord] for pos in positions]
        interpolated_value = lagrange_interpolation(times, y_values, target_time)
        interpolated_position.append(interpolated_value)

    arr = Array(3, sfix)
    arr.assign(interpolated_position)
    return arr


def get_covariance_matrix_at_tca(
    positions, velocities, covariances, tca_pos, tca_vel, t0_frame_i
):
    # Compute RTN frame at t0
    r = positions[t0_frame_i] / mpc_math.sqrt_simplified_fx(
        sum(positions[t0_frame_i] * positions[t0_frame_i])
    )

    rv = Array(3, sfix)
    rv.assign(
        [
            positions[t0_frame_i][1] * velocities[t0_frame_i][2]
            - positions[t0_frame_i][2] * velocities[t0_frame_i][1],
            -(
                positions[t0_frame_i][0] * velocities[t0_frame_i][2]
                - positions[t0_frame_i][2] * velocities[t0_frame_i][0]
            ),
            positions[t0_frame_i][0] * velocities[t0_frame_i][1]
            - positions[t0_frame_i][1] * velocities[t0_frame_i][0],
        ]
    )
    n = rv / (
        1000 * mpc_math.sqrt_simplified_fx(sum((rv / 1000) * (rv / 1000)))
    )  # todo: change scaling factor to max value

    t = Array(3, sfix)
    t.assign(
        [
            n[1] * r[2] - n[2] * r[1],
            -(n[0] * r[2] - n[2] * r[0]),
            n[0] * r[1] - n[1] * r[0],
        ]
    )

    R = Matrix(3, 3, sfix)
    R.assign([r, t, n])

    cov_t0_ = covariances[t0_frame_i]

    # Keep the upper left 3x3 matrix from the 6x6 covariance matrix
    cov_t0 = Matrix(3, 3, sfix)
    cov_t0.assign([cov_t0_[0:3], cov_t0_[6:9], cov_t0_[12:15]])

    P_rtn_t0 = R.dot(cov_t0).dot(R.transpose())

    # Compute RTN frame at t1
    r = tca_pos / mpc_math.sqrt_simplified_fx(sum(tca_pos * tca_pos))

    rv = Array(3, sfix)
    rv.assign(
        [
            tca_pos[1] * tca_vel[2] - tca_pos[2] * tca_vel[1],
            -(tca_pos[0] * tca_vel[2] - tca_pos[2] * tca_vel[0]),
            tca_pos[0] * tca_vel[1] - tca_pos[1] * tca_vel[0],
        ]
    )

    n = rv / (1000 * mpc_math.sqrt_simplified_fx(sum((rv) / 1000 * (rv) / 1000)))

    t.assign(
        [
            n[1] * r[2] - n[2] * r[1],
            -(n[0] * r[2] - n[2] * r[0]),
            n[0] * r[1] - n[1] * r[0],
        ]
    )

    R.assign([r, t, n])

    covariance_matrix = R.transpose().dot(P_rtn_t0).dot(R)

    return covariance_matrix


# Party 0 inputs
positions_0 = MultiArray([n, 3], sfix)
velocities_0 = MultiArray([n, 3], sfix)
covariances_0 = MultiArray([n, 6 * 6], sfix)

# Party 1 inputs
positions_1 = MultiArray([n, 3], sfix)
velocities_1 = MultiArray([n, 3], sfix)
covariances_1 = MultiArray([n, 6 * 6], sfix)

# Load state vectors
for i in range(n):
    positions_0[i].input_from(0)
    velocities_0[i].input_from(0)
    positions_1[i].input_from(1)
    velocities_1[i].input_from(1)

# Load covariances
for i in range(n):
    covariances_0[i].input_from(0)
    covariances_1[i].input_from(1)

# --- PHASE 2 ---

# 1. Compute apogees and perigees
#    Check for conjunction
#    (ignored)

# 2. Divide orbit into sub-intervals
n_ = int(n / n_frames_per_sub_interval - 1)
miss_distances_minima = []
tca_rel_position_norm = sfix(0.0)
tca = sfix(0.0)
tca_window_first_index = sint(0)
tca_position_0 = Array(3, sfix)
tca_position_1 = Array(3, sfix)
tca_velocity_0 = Array(3, sfix)
tca_velocity_1 = Array(3, sfix)


# 3. Check for sub-intervals that container local minimum
@for_range_opt(n_)
def _(i):
    a = i * n_frames_per_sub_interval
    a = (a == 0).if_else(a, a - 1)

    relative_position_vector = positions_1[a] - positions_0[a]
    relative_velocity_vector = velocities_1[a] - velocities_0[a]

    norm = mpc_math.sqrt_simplified_fx(
        sum(relative_position_vector * relative_position_vector)
    )
    first_miss_distance_derivative = (
        relative_velocity_vector.dot(relative_position_vector) / norm
    )  # this division is a bottleneck

    relative_position_vector = (
        positions_1[a + n_frames_per_sub_interval - 1]
        - positions_0[a + n_frames_per_sub_interval - 1]
    )
    relative_velocity_vector = (
        velocities_1[a + n_frames_per_sub_interval - 1]
        - velocities_0[a + n_frames_per_sub_interval - 1]
    )

    norm = mpc_math.sqrt_simplified_fx(
        sum(relative_position_vector * relative_position_vector)
    )

    last_miss_distance_derivative = (
        relative_velocity_vector.dot(relative_position_vector) / norm
    )

    check = (first_miss_distance_derivative < 0).bit_and(
        last_miss_distance_derivative > 0
    )

    @if_(check.reveal() == 1)
    def _():
        # 4. Find minimum miss distance
        base_positions_0 = [
            positions_0[a + p] for p in range(n_frames_per_sub_interval)
        ]
        base_positions_1 = [
            positions_1[a + p] for p in range(n_frames_per_sub_interval)
        ]
        base_velocities_0 = [
            velocities_0[a + p] for p in range(n_frames_per_sub_interval)
        ]
        base_velocities_1 = [
            velocities_1[a + p] for p in range(n_frames_per_sub_interval)
        ]
        lower_bound_target_time = sfix(0)
        upper_bound_target_time = sfix(10)
        for _ in range(n_iterations):
            middle_bound_target_time = (
                lower_bound_target_time
                + (upper_bound_target_time - lower_bound_target_time) / 2.0
            )
            # Interpolate states
            pos_0_lower = interpolate_state_vectors(
                base_times, base_positions_0, lower_bound_target_time
            )
            pos_1_lower = interpolate_state_vectors(
                base_times, base_positions_1, lower_bound_target_time
            )
            vel_0_lower = interpolate_state_vectors(
                base_times, base_velocities_0, lower_bound_target_time
            )
            vel_1_lower = interpolate_state_vectors(
                base_times, base_velocities_1, lower_bound_target_time
            )

            pos_0_middle = interpolate_state_vectors(
                base_times, base_positions_0, middle_bound_target_time
            )
            pos_1_middle = interpolate_state_vectors(
                base_times, base_positions_1, middle_bound_target_time
            )
            vel_0_middle = interpolate_state_vectors(
                base_times, base_velocities_0, middle_bound_target_time
            )
            vel_1_middle = interpolate_state_vectors(
                base_times, base_velocities_1, middle_bound_target_time
            )

            rel_pos_lower = pos_1_lower - pos_0_lower
            rel_vel_lower = vel_1_lower - vel_0_lower
            rel_pos_middle = pos_1_middle - pos_0_middle
            rel_vel_middle = vel_1_middle - vel_0_middle

            lower_norm = mpc_math.sqrt_simplified_fx(sum(rel_pos_lower * rel_pos_lower))
            middle_norm = mpc_math.sqrt_simplified_fx(
                sum(rel_pos_middle * rel_pos_middle)
            )

            lower_derivative = (rel_pos_lower).dot(rel_vel_lower) / lower_norm
            middle_derivative = (rel_pos_middle).dot(rel_vel_middle) / middle_norm

            # Choose interval
            check = (lower_derivative < 0).bit_and(middle_derivative > 0)
            upper_bound_target_time = check.if_else(
                middle_bound_target_time, upper_bound_target_time
            )
            lower_bound_target_time = check.if_else(
                lower_bound_target_time, middle_bound_target_time
            )

        miss_distance = mpc_math.sqrt_simplified_fx(
            sum(rel_pos_middle * rel_pos_middle)
        )

        print_ln(
            "%s -> %s %s %s",
            (a + middle_bound_target_time).reveal(),
            pos_0_middle.reveal(),
            pos_1_middle.reveal(),
            miss_distance.reveal(),
        )

        check_ = (tca_rel_position_norm == 0).bit_or(
            miss_distance < tca_rel_position_norm
        )
        tca_position_0.assign(check_.if_else(pos_0_middle, tca_position_0))
        tca_position_1.assign(check_.if_else(pos_1_middle, tca_position_1))
        tca_velocity_0.assign(check_.if_else(vel_0_middle, tca_velocity_0))
        tca_velocity_1.assign(check_.if_else(vel_1_middle, tca_velocity_1))
        tca_rel_position_norm.update(
            check_.if_else(miss_distance, tca_rel_position_norm)
        )
        tca.update(check_.if_else(a + middle_bound_target_time, tca))
        tca_window_first_index.update(check_.if_else(a, tca_window_first_index))


#print_ln(
#    "TCA: %s %s %s %s %s",
#    tca.reveal(),
#    tca_position_0.reveal(),
#    tca_position_1.reveal(),
#    tca_velocity_0.reveal(),
#    tca_velocity_1.reveal(),
#)

# 5. Interpolate covariances
tca_cov_0 = get_covariance_matrix_at_tca(
    positions_0,
    velocities_0,
    covariances_0,
    tca_position_0,
    tca_velocity_0,
    tca_window_first_index.reveal(),
)

tca_cov_1 = get_covariance_matrix_at_tca(
    positions_1,
    velocities_1,
    covariances_1,
    tca_position_1,
    tca_velocity_1,
    tca_window_first_index.reveal(),
)

# 6. Check if the objects are in a conjunction (ignored)

# --- PHASE 3 ---

# 1. Combined covariance in the B-plane
combined_cov = tca_cov_0 + tca_cov_1

delta_r = tca_position_1 - tca_position_0
delta_v = tca_velocity_1 - tca_velocity_0

delta_r_abs = (delta_r**2) ** 0.5

cross_r_v = Array(3, sfix)
cross_r_v.assign(
    [
        delta_r[1] * delta_v[2] - delta_r[2] * delta_v[1],
        -(delta_r[0] * delta_v[2] - delta_r[2] * delta_v[0]),
        delta_r[0] * delta_v[1] - delta_r[1] * delta_v[0],
    ]
)

cross_r_v_abs = (cross_r_v**2) ** 0.5

xb = delta_r / delta_r_abs
yb = cross_r_v / cross_r_v_abs

r_x_y = MultiArray([2, 3], sfix)
r_x_y.assign([xb, yb])

combined_cov_b = r_x_y.dot(combined_cov).dot(r_x_y.transpose())
miss_distance_b = Array(2, sfix)
miss_distance_b.assign([mpc_math.sqrt_simplified_fx(sum(delta_r * delta_r)), 0.0])

# Final outputs
print_ln("Cov b-plane: %s", combined_cov_b.reveal())
print_ln("Relative position b-plane: %s", miss_distance_b.reveal())
